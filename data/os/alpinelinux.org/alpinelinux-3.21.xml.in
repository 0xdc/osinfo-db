  <os id="http://alpinelinux.org/alpinelinux/3.21">
    <short-id>alpinelinux3.21</short-id>
    <name>Alpine Linux 3.21</name>
    <version>3.21</version>
    <vendor>Alpine Linux Project</vendor>
    <family>linux</family>
    <distro>alpinelinux</distro>
    <upgrades id="http://alpinelinux.org/alpinelinux/3.20"/>
    <derives-from id="http://alpinelinux.org/alpinelinux/3.20"/>

    <release-date>2024-12-05</release-date>
    <eol-date>2026-11-01</eol-date>

    <resources arch="all">
      <minimum>
        <cpu>1000000000</cpu>
        <n-cpus>1</n-cpus>
        <ram>134217728</ram>
        <storage>1073741824</storage>
      </minimum>
      <recommended>
        <cpu>1000000000</cpu>
        <n-cpus>1</n-cpus>
        <ram>805306368</ram>
        <storage>4294967296</storage>
      </recommended>
    </resources>

    <variant id="standard">
      <name>Alpine Linux 3.21 Standard</name>
    </variant>
    <variant id="extended">
      <name>Alpine Linux 3.21 Extended</name>
    </variant>
    <variant id="virtual">
      <name>Alpine Linux 3.21 Virtual</name>
    </variant>
    <variant id="xen">
      <name>Alpine Linux 3.21 Xen</name>
    </variant>
    <variant id="bios-tiny">
      <name>Alpine Linux 3.21 Cloud (bios, tiny)</name>
    </variant>
    <variant id="bios-cloudinit">
      <name>Alpine Linux 3.21 Cloud (bios, cloudinit)</name>
    </variant>
    <variant id="uefi-tiny">
      <name>Alpine Linux 3.21 Cloud (uefi, tiny)</name>
    </variant>
    <variant id="uefi-cloudinit">
      <name>Alpine Linux 3.21 Cloud (uefi, cloudinit)</name>
    </variant>
    <variant id="bios-tiny-metal">
      <name>Alpine Linux 3.21 Cloud (bios, tiny, metal)</name>
    </variant>
    <variant id="bios-cloudinit-metal">
      <name>Alpine Linux 3.21 Cloud (bios, cloudinit, metal)</name>
    </variant>
    <variant id="uefi-tiny-metal">
      <name>Alpine Linux 3.21 Cloud (uefi, tiny, metal)</name>
    </variant>
    <variant id="uefi-cloudinit-metal">
      <name>Alpine Linux 3.21 Cloud (uefi, cloudinit, metal)</name>
    </variant>

    <!-- Standard Installer !-->
    <media arch="aarch64">
      <variant id="standard"/>
      <url>https://dl-cdn.alpinelinux.org/v3.21/releases/aarch64/alpine-standard-3.21.7-aarch64.iso</url>
      <iso>
        <volume-id>alpine-std 3\.21.* aarch64$</volume-id>
      </iso>
      <kernel>boot/vmlinuz-lts</kernel>
      <initrd>boot/initramfs-lts</initrd>
    </media>
    <media arch="i686">
      <variant id="standard"/>
      <url>https://dl-cdn.alpinelinux.org/v3.21/releases/x86/alpine-standard-3.21.7-x86.iso</url>
